# ===================================================================
# CICD 파이프라인 설정 (Jenkinsfile / scripts 가 공통으로 참조)
# 폐쇄망: Gitea(clone/GitOps) · Nexus(npm) 는 cicd 로컬 터널로, NCR 은 인터넷 egress 로 접근.
# **Jenkins=CI만**: 빌드→NCR push→GitOps 태그 커밋. 배포(NKS)는 ArgoCD(CD)가 담당.
# ===================================================================

# ---- 앱 / 소스 (Gitea) ----
APP_NAME=acme-app
# Gitea git-SSH clone URL. cicd 의 gitea 터널(host.docker.internal:2222 → gitea git-ssh)을 통해 접근.
GITEA_SSH_URL=ssh://git@host.docker.internal:2222/admin/acme-app.git
# 환경 매핑: branch dev->dev, test->test, main 또는 tag v*->prd (Jenkinsfile ENV_FOR_REF 와 일치)

# ---- Nexus (npm 레지스트리) ----
# cicd 의 nexus 터널(localhost:8443 → nexus:443)로 접근. 빌드는 --network host 로 이 터널을 봄.
NEXUS_NPM_REGISTRY=https://localhost:8443/repository/npm-group/
NEXUS_HOST=localhost:8443
NEXUS_CI_USER=ci
# NEXUS_CI_PASSWORD 는 Jenkins Credentials(id: nexus-ci)로 주입 — 평문 저장 금지.

# ---- NCR (NHN Container Registry) ----
# docker login(basic auth)으로 push. 자격은 Jenkins Credentials(id: ncr-cred, username=access/pw=secret).
# 컴포넌트별 이미지: ${NCR_REGISTRY}/${NCR_PROJECT}/${APP_NAME}-<component>:<tag>
NCR_REGISTRY=<NCR_REGISTRY_HOST>        # 예: xxxxxxxx-kr1-registry.container.nhncloud.com
NCR_PROJECT=acme-poc

# ---- GitOps repo (ArgoCD 가 감시, CI 가 이미지 태그 커밋) ----
# Gitea 의 config-repo. Jenkins 는 gitea-ssh 자격으로 push, ArgoCD 는 이 repo 를 watch.
GITOPS_REPO_URL=ssh://git@host.docker.internal:2222/admin/config-repo.git
GITOPS_BRANCH=main

# 환경별 배포 대상(참고, 실제 렌더는 gitops/helm 또는 config-repo/apps/test-app-<env>):
#   dev: ns=acme-app-dev / test: ns=acme-app-test / prd: ns=acme-app-prd  (노드 taint/label env=<env>)
