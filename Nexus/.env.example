# ===================================================================
# Nexus Repository (nexus3) - 환경 설정
# 배포 전 ADMIN_PASSWORD, TLS_DOMAIN 을 반드시 변경하세요.
# ===================================================================

# 컨테이너 이미지 (버전 고정 - 로컬에서 저장한 이미지와 반드시 동일해야 함)
NEXUS_IMAGE=sonatype/nexus3:3.70.1
# TLS를 종료하는 리버스 프록시 (같은 tar.gz 에 함께 저장/로드됨)
NGINX_IMAGE=nginx:1.27-alpine
IMAGE_TAR_NAME=nexus-image.tar.gz

# ===== SSH 전송 대상 VM (scripts/02-transfer-to-vm.sh 가 사용, 로컬 PC에서만 필요) =====
# VM_SSH_HOST/VM_SSH_USER 는 반드시 채워야 합니다. SSH 키 인증(ssh-copy-id 등) 사전 설정 필요.
VM_SSH_HOST=acme-nexus
VM_SSH_USER=ubuntu
VM_SSH_PORT=22
VM_REMOTE_DIR=/home/ubuntu/Nexus

# 호스트(VM)에 노출할 포트
# HTTP(8081)는 더 이상 직접 노출하지 않습니다 - nginx가 443에서 TLS로 받아 내부적으로 프록시합니다.
TLS_PORT=443
TLS_HTTP_PORT=80

# ===== TLS (자체 서명 인증서, scripts/04-generate-tls-cert.sh 가 사용) =====
# VM의 실제 접속 주소(IP 또는 사내 도메인)로 반드시 변경 - 인증서 CN/SAN에 사용됨
TLS_DOMAIN=<NEXUS_IP>
TLS_CERT_DAYS=825

TZ=Asia/Seoul

# nexus 컨테이너 프로세스 uid/gid (./nexus-data 소유권과 일치해야 함, 고정값)
NEXUS_UID=200
NEXUS_GID=200

# JVM 힙 설정 - VM 리소스에 맞게 조정 (Nexus 권장 최소 4GB RAM)
NEXUS_MIN_HEAP=1200m
NEXUS_MAX_HEAP=1200m

# CLI(REST API)로 자동 설정할 admin 비밀번호
ADMIN_PASSWORD=ChangeMe123!
# true 로 설정 시 익명(anonymous) 접근을 비활성화합니다
DISABLE_ANONYMOUS_ACCESS=true
