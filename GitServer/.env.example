# ===================================================================
# Gitea Git Server - 환경 설정
# 배포 전 ADMIN_PASSWORD, GITEA_DOMAIN 을 반드시 변경하세요.
# ===================================================================

# 컨테이너 이미지 (버전 고정 - 로컬에서 저장한 이미지와 반드시 동일해야 함)
GITEA_IMAGE=gitea/gitea:1.23.1
# TLS를 종료하는 리버스 프록시 (같은 tar.gz 에 함께 저장/로드됨)
NGINX_IMAGE=nginx:1.27-alpine
IMAGE_TAR_NAME=gitea-image.tar.gz

# ===== SSH 전송 대상 VM (scripts/02-transfer-to-vm.sh 가 사용, 로컬 PC에서만 필요) =====
# VM_SSH_HOST/VM_SSH_USER 는 반드시 채워야 합니다. SSH 키 인증(ssh-copy-id 등) 사전 설정 필요.
VM_SSH_HOST=acme-git
VM_SSH_USER=ubuntu
VM_SSH_PORT=22
VM_REMOTE_DIR=/home/ubuntu/GitServer

# 호스트(VM)에 노출할 포트
# HTTP(3000)는 더 이상 직접 노출하지 않습니다 - nginx가 443에서 TLS로 받아 내부적으로 프록시합니다.
TLS_PORT=443
TLS_HTTP_PORT=80
SSH_PORT=2222

# ===== TLS (자체 서명 인증서, scripts/04-generate-tls-cert.sh 가 사용) =====
# VM의 실제 접속 주소(IP 또는 사내 도메인)로 반드시 변경 - 인증서 CN/SAN 및 Gitea ROOT_URL에 사용됨
TLS_DOMAIN=<GITEA_IP>
TLS_CERT_DAYS=825

# 컨테이너 내부 git 사용자 uid/gid (./data 디렉터리 소유권과 일치해야 함)
USER_UID=1000
USER_GID=1000

TZ=Asia/Seoul

# VM의 실제 접근 주소로 반드시 변경 (clone URL 등에 사용됨). 위 TLS_DOMAIN 과 동일한 값을 권장합니다.
GITEA_DOMAIN=<GITEA_IP>
GITEA_ROOT_URL=https://<GITEA_IP>/

# CLI로 자동 생성할 초기 관리자 계정 (scripts/05-start.sh 가 사용)
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_EMAIL=admin@example.com

# SECRET_KEY / INTERNAL_TOKEN 은 scripts/00-generate-secrets.sh 실행 시
# 자동으로 채워집니다. 직접 값을 입력하지 마세요.
GITEA_SECRET_KEY=
GITEA_INTERNAL_TOKEN=
