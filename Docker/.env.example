# ===================================================================
# Docker Engine (정적 바이너리) - 환경 설정
# 폐쇄망 VM에 Docker 를 설치하기 위한 선행 단계입니다.
# GitServer / Jenkins / Nexus 구축보다 먼저 각 VM에서 진행하세요.
# ===================================================================

# Docker Engine 버전 (배포 목록: https://download.docker.com/linux/static/stable/<ARCH>/)
# 아래는 예시 버전입니다. 다운로드 전 최신 안정 버전을 확인해 필요 시 변경하세요.
DOCKER_VERSION=27.3.1

# Docker Compose 플러그인 버전 (배포 목록: https://github.com/docker/compose/releases)
COMPOSE_VERSION=v2.29.7

# CPU 아키텍처: x86_64 또는 aarch64 (VM과 반드시 일치해야 함)
ARCH=x86_64

TZ=Asia/Seoul

# ===== SSH 전송 대상 VM (scripts/02-transfer-to-vm.sh 가 사용, 로컬 PC에서만 필요) =====
# VM_SSH_HOST/VM_SSH_USER 는 반드시 채워야 합니다. SSH 키 인증(ssh-copy-id 등) 사전 설정 필요.
# GitServer/Jenkins/Nexus 세 VM에 각각 Docker를 설치해야 하므로, VM마다 이 값을 바꿔가며
# 02-transfer-to-vm.sh 를 여러 번 실행하세요 (또는 VM별로 이 디렉터리를 복사해 두세요).
VM_SSH_HOST=acme-nexus
VM_SSH_USER=ubuntu
VM_SSH_PORT=22
VM_REMOTE_DIR=/home/ubuntu/Docker

# 설치 후 sudo 없이 docker 명령을 쓰도록 SSH 접속 사용자를 docker 그룹에 추가할지 여부
ADD_USER_TO_DOCKER_GROUP=true
