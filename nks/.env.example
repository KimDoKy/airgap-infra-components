# ===================================================================
# NKS (NHN Kubernetes Service) 셋업 - 환경 설정
# 이 파일을 .env 로 복사해 값을 채운 뒤 scripts/NN-*.sh 를 순서대로 실행.
# 전제: 로컬에 kubectl(대상 NKS 컨텍스트) + helm + openssl.
# ===================================================================

# ── 노드 → 환경 매핑 (kubectl get nodes 의 노드 이름) ──────────────
# 환경별로 노드 이름을 지정(공백 구분으로 여러 개 가능). 비우면 해당 env 는 스킵.
#   dev/test/prd = 워크로드 환경(각 NoSchedule taint), ops = 플랫폼(ArgoCD/모니터링/Ingress).
NODE_DEV=""
NODE_TEST=""
NODE_PRD=""
NODE_OPS=""

# label/taint 키 (앱 매니페스트의 nodeSelector/tolerations 와 반드시 일치). 값 = dev/test/prd/ops.
ENV_KEY=env
# taint 의 목적 = **앱 배포 격리 전용**. dev/test/prd 만 NoSchedule taint. ops 는 항상 라벨만(taint 없음).
#   ops 에는 ArgoCD/모니터링/Ingress + NKS 시스템 애드온(CoreDNS 등)이 taint 영향 없이 스케줄된다.
# taint 적용 주체:
#   APPLY_TAINT=true  → (테스트) 01-label-taint-nodes.sh 가 dev/test/prd 에 taint 를 건다.
#   APPLY_TAINT=false → (운영) taint 는 **NKS 노드그룹 생성 시** 지정 → 스크립트는 라벨만 적용.
APPLY_TAINT=true

# ── NCR (NHN Container Registry) ───────────────────────────────────
NCR_REGISTRY=<NCR_REGISTRY_HOST>     # 예: xxxxxxxx-kr1-registry.container.nhncloud.com
NCR_PROJECT=acme-poc
NCR_ACCESS_KEY=<NCR_ACCESS_KEY>
NCR_SECRET_KEY=<NCR_SECRET_KEY>
APP_NS_PREFIX=acme-app              # 네임스페이스: acme-app-dev / -test / -prd

# ── ArgoCD ↔ config-repo (Gitea) ───────────────────────────────────
GITEA_REPO_URL=https://<GITEA_IP>/admin/config-repo.git   # NKS→Gitea 도달 필요(SG: 노드 CIDR→Gitea:443)
GITEA_USER=admin
GITEA_PASSWORD=<GITEA_ADMIN_PW>
ARGOCD_INSECURE_REPO=true            # Gitea 자체서명 인증서 → true

# ── 모니터링 / Ingress ─────────────────────────────────────────────
GRAFANA_ADMIN_PW=<GRAFANA_PW>
PROM_BASIC_USER=oncall
PROM_BASIC_PW=<PROM_BASIC_PW>
# Ingress LB 공인 IP. 비우면 05-install-ingress.sh 이후 자동 조회(nip.io host 구성에 사용).
LB_IP=""
