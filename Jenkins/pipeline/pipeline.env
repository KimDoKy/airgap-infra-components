# ===================================================================
# CICD 파이프라인 설정 (Jenkinsfile / scripts 가 공통으로 참조)
# 폐쇄망: Gitea(clone/GitOps) · Nexus(npm) 는 사내망, ECR 는 VPC 엔드포인트(프라이빗).
# **Jenkins=CI만**: 빌드→ECR push→GitOps 태그 커밋. 배포(EKS)는 ArgoCD(CD)가 담당 → Jenkins 는 EKS 미접근.
# <...> 표시는 ECR 생성 후 실제 값으로 채우세요. (현재 무검증 스캐폴드)
# ===================================================================

# ---- 앱 / 소스 (Gitea) ----
APP_NAME=acme-app
# Gitea git-SSH clone URL. SG 에 cicd→gitea:2222 규칙이 열려 있어야 함.
GITEA_SSH_URL=ssh://git@<GITEA_IP>:2222/acme/acme-app.git
# 환경 매핑: 어떤 git ref 가 어떤 배포 환경으로 가는지 (아래 Jenkinsfile ENV_FOR_REF 와 일치)
#   branch dev  -> dev,  branch stg -> stg,  branch main 또는 tag v* -> prd

# ---- Nexus (npm 레지스트리) ----
# SG 에 cicd→nexus:443 규칙이 열려 있어야 함. group = proxy+hosted 묶음(있으면), 없으면 hosted 직접.
NEXUS_NPM_REGISTRY=https://<NEXUS_IP>/repository/npm-group/
NEXUS_HOST=<NEXUS_IP>
NEXUS_CI_USER=ci
# NEXUS_CI_PASSWORD 는 Jenkins Credentials(id: nexus-ci)로 주입 — 여기에 평문 저장 금지.

# ---- AWS / ECR (미생성 — 채우기) ----
# aws CLI 미사용: 자격은 cicd VM IAM 인스턴스 프로파일(IMDSv2), ECR 인증은 REST(SigV4).
# ECR/S3 는 인터넷 없이 VPC 엔드포인트(PrivateLink)로 접근한다고 가정. (EKS 접근은 이제 ArgoCD 담당)
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=<AWS_ACCOUNT_ID>
# 컴포넌트별 리포: 스크립트가 <ECR_REPO>-<component> 로 push → acme-app-frontend / acme-app-backend
ECR_REGISTRY=<AWS_ACCOUNT_ID>.dkr.ecr.ap-northeast-2.amazonaws.com
ECR_REPO=acme-app

# ---- GitOps repo (ArgoCD 가 감시, CI 가 이미지 태그 커밋) ----
# Gitea 의 별도 저장소. Jenkins 는 gitea-ssh 자격으로 push, ArgoCD 는 이 repo 를 watch.
GITOPS_REPO_URL=ssh://git@<GITEA_IP>:2222/acme/acme-gitops.git
GITOPS_BRANCH=main

# 환경별 배포 대상(참고, 실제 렌더는 gitops/helm/acme-app/values-<env>.yaml):
#   dev: ns=acme-app-dev  / stg: ns=acme-app-stg / prd: ns=acme-app-prd  (노드 taint/label env=<env>)
