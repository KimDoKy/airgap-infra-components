# ===================================================================
# Jenkins - 환경 설정
# 배포 전 JENKINS_ADMIN_PASSWORD, TLS_DOMAIN 을 반드시 변경하세요.
# ===================================================================

# 컨테이너 이미지 (버전 고정 - 로컬에서 저장한 이미지와 반드시 동일해야 함)
JENKINS_IMAGE=jenkins/jenkins:2.541.3-lts-jdk17
# TLS를 종료하는 리버스 프록시 (같은 tar.gz 에 함께 저장/로드됨)
NGINX_IMAGE=nginx:1.27-alpine
IMAGE_TAR_NAME=jenkins-image.tar.gz

# ===== SSH 전송 대상 VM (scripts/02-transfer-to-vm.sh 가 사용, 로컬 PC에서만 필요) =====
# VM_SSH_HOST/VM_SSH_USER 는 반드시 채워야 합니다. SSH 키 인증(ssh-copy-id 등) 사전 설정 필요.
VM_SSH_HOST=acme-cicd
VM_SSH_USER=ubuntu
VM_SSH_PORT=22
VM_REMOTE_DIR=/home/ubuntu/Jenkins

# 호스트(VM)에 노출할 포트
# HTTP(8080)는 더 이상 직접 노출하지 않습니다 - nginx가 443에서 TLS로 받아 내부적으로 프록시합니다.
TLS_PORT=443
TLS_HTTP_PORT=80
AGENT_PORT=50000

# ===== TLS (자체 서명 인증서, scripts/04-generate-tls-cert.sh 가 사용) =====
# VM의 실제 접속 주소(IP 또는 사내 도메인)로 반드시 변경 - 인증서 CN/SAN에 사용됨
TLS_DOMAIN=<CICD_IP>
TLS_CERT_DAYS=825

TZ=Asia/Seoul

# jenkins 컨테이너 프로세스 uid/gid (./jenkins_home 소유권과 일치해야 함)
JENKINS_UID=1000
JENKINS_GID=1000

# init.groovy.d 스크립트가 기동 시 CLI(무인)로 자동 생성하는 관리자 계정
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=ChangeMe123!
